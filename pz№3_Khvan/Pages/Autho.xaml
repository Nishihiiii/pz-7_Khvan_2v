<Page x:Class="pz_3_Khvan.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:pz_3_Khvan.Pages"
      mc:Ignorable="d"
      d:DesignHeight="520"
      d:DesignWidth="800"
      Title="Авторизация"
      Background="White">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition/>
			<ColumnDefinition Width="250"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="10">

			<!-- Блок логина -->
			<TextBlock Text="Логин:" Margin="0,0,0,4"/>
			<TextBox x:Name="txtbLogin" Padding="4" Margin="0,0,0,14"/>

			<!-- Блок пароля -->
			<TextBlock Text="Пароль:" Margin="0,0,0,4"/>
			<Grid Margin="0,0,0,10">
				<PasswordBox x:Name="pswbPassword" Padding="4" Margin="0"/>
				<TextBox x:Name="txtVisiblePassword" Padding="4" Margin="0" Visibility="Collapsed"/>
			</Grid>

			<CheckBox x:Name="chkShowPassword"
                      VerticalContentAlignment="Center"
                      Checked="chkShowPassword_Checked"
                      Unchecked="chkShowPassword_Unchecked"
                      Margin="0,0,0,16">
				<TextBlock Text="Показать пароль"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
			</CheckBox>

			<!-- Предупреждение об оставшихся попытках -->
			<TextBlock x:Name="txtAttemptsLeft"
                       Foreground="DarkOrange"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,0,0,12"/>

			<!-- Весь блок CAPTCHA целиком ВЫШЕ кнопок -->
			<TextBlock x:Name="txtBlockCaptcha"
                       Text="Введите символы с картинки:"
                       Visibility="Collapsed"
                       Margin="0,4,0,6"/>

			<TextBlock x:Name="txtCaptcha"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,0,0,10"/>

			<TextBox x:Name="txtboxCaptcha"
                     Padding="4"
                     Visibility="Collapsed"
                     Margin="0,0,0,10"/>

			<Button x:Name="btnRefreshCaptcha"
        Click="btnRefreshCaptcha_Click"
        HorizontalAlignment="Center"
        VerticalContentAlignment="Center"
        Width="Auto"
        Height="Auto"
        Padding="16,8"
        Visibility="Collapsed"
        Margin="0,0,0,16">
				<TextBlock Text="Обновить CAPTCHA"
               Margin="0"
               VerticalAlignment="Center"/>
			</Button>

			<TextBlock x:Name="txtBlockTimer"
                       Foreground="Red"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,4,0,14"/>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">

				<Button x:Name="btnEnterGuests"
                        Content="Войти как гость"
                        Click="btnEnterGuests_Click"
                        Width="Auto"
                        MinWidth="130"
                        Margin="0,0,14,0"
                        Padding="12,5"/>

				<Button x:Name="btnEnter"
                        Content="Войти"
                        Click="btnEnter_Click"
                        Width="Auto"
                        MinWidth="100"
                        Padding="14,5"/>

			</StackPanel>

		</StackPanel>
	</Grid>
</Page>